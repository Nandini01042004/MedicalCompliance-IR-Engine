{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Run Streamlit Web Dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/frontend/app.py",
        "--server.port",
        "8501"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "2. Run FastAPI Production Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "src.api.server:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "3. Run IR Benchmark Evaluation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/evaluation/run_experiments.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "4. Run Pytest Test Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
